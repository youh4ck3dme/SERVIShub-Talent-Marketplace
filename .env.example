# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres (Supabase → Database → Connection string)
# DATABASE_URL = pooled (Transaction / port 6543) for runtime
# DIRECT_URL  = direct (Session / port 5432) for Prisma migrations
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Stripe Connect (placeholder — implementácia mimo scaffold)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Google Maps (placeholder)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# Email (placeholder)
RESEND_API_KEY=re_xxx

# Sentry (optional — bez DSN je monitoring vypnutý; vyžaduje pnpm add @sentry/nextjs)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Talent job alerts — cron endpoint must never be publicly triggered without bearer secret
CRON_SECRET=
ALERT_UNSUBSCRIBE_SECRET=
RESEND_FROM=jobs@example.com # verified sender domain required for delivery

# Headless WordPress Editorial CMS (server-only)
WP_GRAPHQL_ENDPOINT=
WP_WEBHOOK_SECRET=
